---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrderCheck from '../../components/OrderCheck.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SpiceLevel from '../../components/SpiceLevel.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { getProjects, getRelated, SECTION_META, youtubeIdFromUrl, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const related = await getRelated(project, 2);
const section = SECTION_META[data.section];
const videoId = data.video ? youtubeIdFromUrl(data.video) : undefined;

// Share image: the first real photo, cropped. Placeholder images fall back to the site default.
const shareSource = data.images.find((image) => !image.alt.includes('PLACEHOLDER'));
const shareImage = shareSource
  ? (await getImage({ src: shareSource.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : undefined;
---

<BaseLayout
  title={data.name}
  description={`${data.description} Made at: ${data.madeAt}.`}
  ogType="article"
  ogImage={shareImage}
  slip="float"
>
  <article class="wrap dish">
    <p class="crumbs">
      <a class="link" href="/#menu">Menu</a>
      <span aria-hidden="true">/</span>
      <span><span lang="zh-Hant">{section.zh}</span> {section.en}</span>
    </p>

    <header class="dish__head laminated">
      <div class="dish__intro">
        <p class="dish__code">
          <span class="code-badge">{data.code}</span>
          <span class="made-at">Made at: {data.madeAt}</span>
        </p>
        <h1 class="dish__name">{data.name}</h1>
        <p class="dish__desc">{data.description}</p>

        {
          data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }

        <dl class="dish__meta">
          {
            data.prepTime && (
              <div>
                <dt>Prep time</dt>
                <dd>{data.prepTime}</dd>
              </div>
            )
          }
          <div>
            <dt>Spice</dt>
            <dd>
              <SpiceLevel level={data.spice} />
            </dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>
              {data.status === 'in-progress' ? <span class="status-badge">In progress</span> : 'Done'}
              {data.placeholder && <span class="placeholder-badge">PLACEHOLDER</span>}
            </dd>
          </div>
        </dl>

        <OrderCheck id={project.id} name={data.name} />
      </div>

      <!-- Plating animation: the plate is set down, then steam rises. Decorative only. -->
      <div class="plating" aria-hidden="true">
        <svg viewBox="0 0 220 190" focusable="false">
          <g class="plating__steam">
            <path d="M78 96c-12-12 12-22 0-36s12-22 0-34" />
            <path d="M110 92c-12-12 12-24 0-38s12-24 0-38" />
            <path d="M142 96c-12-12 12-22 0-36s12-22 0-34" />
          </g>
          <g class="plating__plate">
            <ellipse class="plating__shadow" cx="110" cy="158" rx="92" ry="12" />
            <ellipse class="plating__rim" cx="110" cy="138" rx="98" ry="26" />
            <ellipse class="plating__well" cx="110" cy="134" rx="66" ry="15" />
            <text class="plating__code" x="110" y="141" text-anchor="middle">{data.code}</text>
          </g>
        </svg>
      </div>
    </header>

    <div class="dish__cols">
      <div class="dish__body prose">
        <Content />
      </div>

      <div class="dish__side">
    {
      data.images.length > 0 && (
        <section class="dish__block" aria-labelledby="gallery-title">
          <h2 id="gallery-title">Photos</h2>
          <ul class="gallery">
            {data.images.map((image) => (
              <li>
                <Image
                  src={image.src}
                  alt={image.alt}
                  widths={[400, 720, 1100]}
                  sizes="(min-width: 68.75rem) 440px, 100vw"
                  loading="lazy"
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      videoId && (
        <section class="dish__block dish__video" aria-labelledby="video-title">
          <h2 id="video-title">Video</h2>
          <VideoFacade youtubeId={videoId} title={`${data.name} video`} />
        </section>
      )
    }
      </div>
    </div>

    <p class="dish__back">
      <a class="btn" href="/#menu">Back to menu</a>
    </p>

    <section class="dish__block" aria-labelledby="more-title">
      <h2 id="more-title">Order something else</h2>
      <div class="card-grid">
        {related.map((other) => <ProjectCard project={other} variant="compact" heading="h3" />)}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .dish {
    padding-top: var(--space-5);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    font-size: var(--text-sm);
  }

  .crumbs [lang='zh-Hant'] {
    font-family: var(--font-zh-display);
    font-weight: 900;
    color: var(--color-red);
  }

  .dish__head {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding: var(--space-5) var(--space-4);
  }

  .dish__intro {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    min-width: 0;
  }

  .dish__code {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .dish__name {
    font-size: var(--text-2xl);
  }

  .dish__desc {
    max-width: var(--prose-max);
    font-size: var(--text-md);
    color: var(--color-ink-soft);
  }

  .dish__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .dish__meta div {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dish__meta dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .dish__meta dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-weight: 700;
  }

  /* ---------- Plating ---------- */

  .plating {
    width: min(100%, 13rem);
    margin-inline: auto;
  }

  .plating svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .plating__plate {
    animation: plate-down 520ms cubic-bezier(0.3, 1.5, 0.5, 1) both;
  }

  .plating__rim {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 3;
  }

  .plating__well {
    fill: var(--color-mint-soft);
    stroke: var(--color-mint-deep);
    stroke-width: 2;
  }

  .plating__shadow {
    fill: rgb(27 23 20 / 0.14);
  }

  .plating__code {
    fill: var(--color-red);
    font-family: var(--font-display);
    font-size: 20px;
  }

  .plating__steam path {
    fill: none;
    stroke: var(--color-ink-soft);
    stroke-width: 4;
    stroke-linecap: round;
    opacity: 0;
    animation: steam-rise 1900ms ease-out 520ms 2 both;
  }

  .plating__steam path:nth-child(2) {
    animation-delay: 760ms;
  }

  .plating__steam path:nth-child(3) {
    animation-delay: 1000ms;
  }

  @keyframes plate-down {
    from {
      opacity: 0;
      transform: translateY(-46px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes steam-rise {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    35% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      transform: translateY(-18px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plating__plate,
    .plating__steam path {
      animation: none;
    }

    .plating__steam path {
      opacity: 0.35;
    }
  }

  /* ---------- Body ---------- */

  .dish__cols {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .dish__side {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    min-width: 0;
  }

  .dish__side .dish__block {
    margin-top: 0;
  }

  .dish__body {
    padding: var(--space-5) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    max-width: none;
  }

  .dish__body > :global(*) {
    max-width: var(--prose-max);
  }

  .dish__body > :global(:first-child) {
    margin-top: 0;
  }

  .dish__block {
    margin-top: var(--space-7);
  }

  .dish__block > h2 {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 4px double var(--color-ink);
    font-size: var(--text-xl);
    text-transform: uppercase;
  }

  .gallery {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .gallery li {
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-paper-shade);
    overflow: hidden;
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .gallery li:hover :global(img) {
    transform: scale(1.02);
  }

  .dish__back {
    margin-top: var(--space-7);
  }

  @media (min-width: 48rem) {
    .dish__head {
      grid-template-columns: minmax(0, 1fr) 14rem;
      align-items: center;
      gap: var(--space-6);
      padding: var(--space-6);
    }

    .dish__body {
      padding: var(--space-6);
    }
  }

  @media (min-width: 68.75rem) {
    .dish__cols {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }

    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
