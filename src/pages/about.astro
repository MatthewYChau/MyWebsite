---
/**
 * About the Chef.
 * The bio is written below. The timeline comes from src/data/timeline.json.
 * The resume button links to public/resume.pdf.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getOrdered } from '../lib/content';

const timeline = await getOrdered('timeline');
---

<BaseLayout
  title="About the Chef"
  description="About Matthew Chau: final-year Mechanical Engineering student at Toronto Metropolitan University, graduating April 2027."
>
  <div class="wrap">
    <header class="page-head">
      <h1>
        <span class="page-head__zh" lang="zh-Hant">主廚</span>
        About the Chef
      </h1>
    </header>

    <div class="about">
      <section class="bio laminated" aria-labelledby="bio-title">
        <h2 id="bio-title">Matthew Chau</h2>
        <div class="prose">
          <p>
            I'm Matthew Chau, a final-year Mechanical Engineering student at Toronto Metropolitan University,
            graduating April 2027.
          </p>
          <p>
            I did a 16-month co-op as Modification Team Lead in Plant Design at Ontario Power Generation. I'm
            Captain of the TMAV student drone team and Co-President of ASHRAE TMU.
          </p>
          <blockquote>
            <p>TODO: add a few lines about what you enjoy working on and the kind of role you are looking for.</p>
          </blockquote>
        </div>
        <p class="bio__actions">
          <a class="btn" href="/resume.pdf" data-astro-reload>Download resume</a>
          <a class="btn btn--quiet" href="/menu/">See the full menu</a>
        </p>
      </section>

      <section class="timeline-block" aria-labelledby="timeline-title">
        <h2 id="timeline-title">Work timeline</h2>
        <ol class="timeline">
          {
            timeline.map(({ data }) => (
              <li class="timeline__item">
                <p class="timeline__dates">
                  {data.start} – {data.end}
                </p>
                <div class="timeline__card">
                  <h3>{data.role}</h3>
                  <p class="made-at">{data.org}</p>
                  <p class="timeline__summary">{data.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
  }

  .bio {
    padding: var(--space-5) var(--space-4);
  }

  .bio h2,
  .timeline-block h2 {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 4px double var(--color-ink);
    font-size: var(--text-xl);
    text-transform: uppercase;
  }

  .bio__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .timeline {
    display: grid;
    gap: var(--space-4);
  }

  .timeline__item {
    display: grid;
    gap: var(--space-2);
  }

  .timeline__dates {
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .timeline__card {
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    box-shadow: var(--shadow-paper);
  }

  .timeline__card h3 {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    letter-spacing: 0;
  }

  .timeline__summary {
    max-width: var(--prose-max);
    margin-top: var(--space-2);
    color: var(--color-ink-soft);
  }

  @media (min-width: 48rem) {
    .bio {
      padding: var(--space-6);
    }

    .timeline__item {
      grid-template-columns: 11.5rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-4);
    }

    .timeline__dates {
      margin-top: var(--space-4);
    }
  }

  @media (min-width: 68.75rem) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
</style>
