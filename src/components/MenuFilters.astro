---
/** Filters above the menu. Needs JavaScript, so it hides without it. */
import { MADE_AT } from '../content.config';

/** The cha chaan teng requests. Each has an English subtitle and a longer explanation. */
const requests = [
  { flag: 'no-progress', zh: '走冰', en: 'No ice', tip: 'Hides items that are still in progress.' },
  { flag: 'no-placeholder', zh: '少甜', en: 'Less sweet', tip: 'Hides placeholder items.' },
];
---

<div class="filters js-only" data-filters>
  <div class="filters__group" role="group" aria-label="Filter by where it was made. One at a time.">
    <span class="filters__label">Made at</span>
    <button type="button" class="chip" aria-pressed="true" data-filter-made="">All</button>
    {
      MADE_AT.map((place) => (
        <button type="button" class="chip" aria-pressed="false" data-filter-made={place}>
          {place}
        </button>
      ))
    }
  </div>

  <div class="filters__group filters__group--requests" role="group" aria-label="Kitchen requests">
    <span class="filters__label">Requests</span>
    {
      requests.map((request) => (
        <span class="request">
          <button
            type="button"
            class="chip chip--request"
            aria-pressed="false"
            data-filter-flag={request.flag}
            aria-describedby={`tip-${request.flag}`}
          >
            <span class="chip__zh" lang="zh-Hant">
              {request.zh}
            </span>
            <span class="chip__sub">{request.en}</span>
          </button>
          <span class="tip" role="tooltip" id={`tip-${request.flag}`}>
            {request.tip}
          </span>
        </span>
      ))
    }
  </div>

  <p class="filters__status">
    <span aria-live="polite" data-filter-status></span>
    <button type="button" class="filters__clear" data-filter-clear hidden>Clear filters</button>
  </p>

  <p class="filters__legend">Prep time is how long it took. Spice is how demanding it was.</p>
</div>

<script>
  import '../scripts/filters';
</script>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    border: 2px dashed var(--color-ink-soft);
    border-radius: var(--radius-md);
    background: var(--color-mint-soft);
  }

  .filters__group {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .filters__label {
    flex: 0 0 100%;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-1) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: 700;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .chip:hover {
    transform: translateY(-1px);
    background: var(--color-yellow-soft);
  }

  .chip:active {
    transform: translateY(1px);
  }

  .chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* a little tighter, so both requests fit on one row on a phone */
  .chip--request {
    gap: var(--space-1);
    padding-inline: var(--space-3);
  }

  .chip__zh {
    font-family: var(--font-zh-display);
    font-weight: 900;
    font-size: var(--text-md);
    line-height: 1;
  }

  /* English subtitle, always visible */
  .chip__sub {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* Longer explanation, shown on hover, keyboard focus or tap */
  .tip {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 5;
    width: max-content;
    max-width: 100%;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
    pointer-events: none;
  }

  .request:hover .tip,
  .request:focus-within .tip {
    visibility: visible;
    opacity: 1;
  }

  .filters__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .filters__status:has([data-filter-status]:empty) {
    display: none;
  }

  .filters__clear {
    min-height: var(--tap);
    padding: 0 var(--space-2);
    border: 0;
    background: none;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .filters__legend {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  /* Wider screens: label beside the chips, and each explanation sits under its own chip. */
  @media (min-width: 40rem) {
    .filters__label {
      flex: 0 0 5rem;
    }

    .request {
      position: relative;
    }

    .chip--request {
      gap: var(--space-2);
      padding-inline: var(--space-4);
    }

    .tip {
      max-width: 20rem;
    }
  }
</style>
