---
/** The "Add to order" tick box on a project card. Needs JavaScript, so it hides without it. */
interface Props {
  id: string;
  name: string;
}

const { id, name } = Astro.props;
---

<label class="order-check js-only">
  <input type="checkbox" class="visually-hidden" data-order-id={id} aria-label={`Add ${name} to order`} />
  <span class="tickbox" aria-hidden="true">
    <svg class="tickbox__tick" viewBox="0 0 24 24" focusable="false">
      <path d="M4 13 C6 14.5 8 17 9.5 20 C12 13 16 7 23 1" pathLength="1"></path>
    </svg>
  </span>
  <span class="order-check__off">Add to order</span>
  <span class="order-check__on">On your slip</span>
</label>

<script>
  import '../scripts/order-sync';
</script>

<style>
  .order-check {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding-inline: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .order-check__on,
  input:checked ~ .order-check__off {
    display: none;
  }

  input:checked ~ .order-check__on {
    display: inline;
    color: var(--color-mint-deep);
  }

  .order-check:hover .tickbox {
    background: var(--color-yellow-soft);
  }
</style>
