---
/**
 * First-visit storefront: a cha chaan teng at night with a neon sign and a glass door.
 * Clicking the door or scrolling plays the way in: through the door, down the aisle,
 * sit at a table, pick up the menu. The menu becomes the menu page (about 3.5 seconds).
 * Skip jumps straight to the menu at any point.
 *
 * It only exists on the menu page ("/"), so links to inner pages never show it.
 * It stays hidden unless the small script in the page <head> (see index.astro)
 * decides to show it: no JavaScript, a returning visitor, "reduce motion" or
 * arriving from another page of this site all go straight to the menu.
 */
import StorefrontInterior from './StorefrontInterior.astro';
---

<div class="storefront" id="storefront" data-storefront-root>
  <button type="button" class="storefront__skip" data-storefront-skip>Skip</button>

  <div class="storefront__scene">
    <div class="shopfront">
      <div class="fascia">
        <p class="neon neon--zh" lang="zh-Hant" aria-hidden="true">茶餐廳</p>
        <p class="neon neon--name">Matthew Chau</p>
        <p class="fascia__sub">Cha Chaan Teng · Portfolio</p>
      </div>

      <div class="glass">
        <div class="window window--left" aria-hidden="true">
          <span class="poster poster--green" lang="zh-Hant">特餐</span>
          <span class="poster poster--white" lang="zh-Hant">小食</span>
          <span class="open-sign">OPEN</span>
        </div>

        <button type="button" class="door" data-storefront-door aria-label="Open the door and see the menu">
          <!-- the dining room, seen through the doorway once the doors swing open -->
          <svg class="door__inside" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <use href="#cct-room"></use>
          </svg>
          <span class="door__leaf door__leaf--left" aria-hidden="true">
            <span class="door__sticker" lang="zh-Hant">推</span>
          </span>
          <span class="door__leaf door__leaf--right" aria-hidden="true">
            <span class="door__sticker">PUSH</span>
          </span>
        </button>

        <div class="window window--right" aria-hidden="true">
          <span class="poster poster--white" lang="zh-Hant">甜品</span>
          <span class="poster poster--green" lang="zh-Hant">飲品</span>
        </div>
      </div>

      <div class="kerb" aria-hidden="true"></div>
    </div>

    <p class="storefront__hint">Click the door or scroll to come in</p>
  </div>

  <StorefrontInterior />
</div>

<script>
  import '../scripts/storefront';
</script>

<style is:global>
  .storefront {
    display: none;
  }

  html.js[data-storefront='show'] {
    overflow: hidden;
  }

  html.js[data-storefront='show'] .storefront {
    position: fixed;
    inset: 0;
    z-index: var(--z-storefront);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    /* Speed of the way in. 1 = about 3.5 seconds. 0.7 is quicker, 1.3 is slower. */
    --pace: 1;
    background:
      radial-gradient(120% 70% at 50% 100%, rgb(247 201 107 / 0.16), transparent 60%),
      linear-gradient(var(--color-night), #0b0f17);
    color: var(--color-paper);
    overflow: hidden;
  }

  .storefront__skip {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 2;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-paper);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-paper);
    font-weight: 700;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .storefront__skip:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .storefront__scene {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    width: min(100%, 56rem);
    transform-origin: 50% 72%;
  }

  .shopfront {
    width: 100%;
    border: 3px solid #0d0b0a;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--color-facade);
    box-shadow: 0 30px 80px -30px #000;
  }

  /* ----- sign band ----- */

  .fascia {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding: clamp(1rem, 4vw, 2.25rem) var(--space-4);
    border-bottom: 3px solid #0d0b0a;
    background: linear-gradient(#1c1917, #26211d);
    text-align: center;
  }

  .neon {
    color: #fff5f5;
    text-shadow:
      0 0 4px #fff,
      0 0 12px var(--color-neon),
      0 0 28px var(--color-neon),
      0 0 60px var(--color-neon-glow);
    animation: neon-flicker 2.6s linear 1 both;
  }

  .neon--name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1rem + 6vw, 4.75rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .neon--zh {
    font-family: var(--font-zh-display);
    font-weight: 900;
    font-size: clamp(1.25rem, 0.9rem + 2vw, 2.25rem);
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    color: #fff9e0;
    text-shadow:
      0 0 4px #fff,
      0 0 12px var(--color-yellow),
      0 0 30px rgb(255 210 63 / 0.6);
  }

  .fascia__sub {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 250 240 / 0.7);
  }

  @keyframes neon-flicker {
    0%,
    6%,
    10%,
    14% {
      opacity: 0.35;
    }
    4%,
    8%,
    12%,
    16%,
    100% {
      opacity: 1;
    }
  }

  /* ----- windows and door ----- */

  .glass {
    display: grid;
    grid-template-columns: 1fr minmax(8.5rem, 0.9fr) 1fr;
    gap: 3px;
    height: clamp(11rem, 34vh, 19rem);
    background: #0d0b0a;
  }

  .window {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-2);
    padding: var(--space-3);
    background:
      linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.16) 38%, transparent 46%),
      linear-gradient(rgb(247 201 107 / 0.92), rgb(226 164 74 / 0.9));
    overflow: hidden;
  }

  .poster {
    display: grid;
    place-items: center;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-zh-display);
    font-weight: 900;
    font-size: clamp(0.95rem, 0.6rem + 1.6vw, 1.6rem);
    line-height: 1.2;
    writing-mode: vertical-rl;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.35);
  }

  .poster--green {
    background: #c9efc4;
    color: #17402f;
  }

  .poster--white {
    background: var(--strip-white);
    color: var(--color-red);
  }

  .open-sign {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    padding: 0.1rem var(--space-2);
    border: 2px solid #3aa0ff;
    border-radius: var(--radius-sm);
    color: #ffe9ea;
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 0.5rem + 0.9vw, 1rem);
    letter-spacing: 0.08em;
    text-shadow:
      0 0 6px var(--color-neon),
      0 0 14px var(--color-neon);
    box-shadow:
      0 0 8px #3aa0ff,
      inset 0 0 8px rgb(58 160 255 / 0.6);
    background: rgb(20 26 38 / 0.75);
  }

  .door {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    padding: 0;
    border: 0;
    background: #120f0d;
    perspective: 900px;
    overflow: hidden;
  }

  .door:focus-visible {
    outline: 4px solid var(--color-yellow);
    outline-offset: 2px;
    z-index: 2;
    overflow: visible;
  }

  .door:focus-visible .door__leaf {
    box-shadow: inset 0 0 0 4px var(--color-yellow);
  }

  .door__inside {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .door__leaf {
    position: relative;
    z-index: 1;
    display: block;
    border: 5px solid #8c8f93;
    background:
      linear-gradient(115deg, transparent 34%, rgb(255 255 255 / 0.22) 42%, transparent 50%),
      linear-gradient(rgb(247 201 107 / 0.85), rgb(214 150 62 / 0.85));
    transition: transform calc(800ms * var(--pace, 1)) var(--ease-in-out);
  }

  .door__leaf--left {
    transform-origin: left center;
  }

  .door__leaf--right {
    transform-origin: right center;
  }

  /* door handles */
  .door__leaf::after {
    content: '';
    position: absolute;
    top: 42%;
    width: 5px;
    height: 22%;
    border-radius: 3px;
    background: #d9dcdf;
  }

  .door__leaf--left::after {
    right: 6px;
  }

  .door__leaf--right::after {
    left: 6px;
  }

  .door__sticker {
    position: absolute;
    top: 26%;
    left: 50%;
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
    background: var(--color-red);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    transform: translateX(-50%);
  }

  .door:hover .door__leaf--left {
    transform: rotateY(12deg);
  }

  .door:hover .door__leaf--right {
    transform: rotateY(-12deg);
  }

  .kerb {
    height: 0.9rem;
    border-top: 3px solid #0d0b0a;
    background: #3a3531;
  }

  .storefront__hint {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgb(255 250 240 / 0.8);
  }

  /*
   * ----- the way in (about 3.5 seconds at --pace: 1) -----
   * Each step is "duration, then start time". Change --pace to speed the whole thing up or down.
   */

  .storefront.is-opening .door__leaf--left {
    transform: rotateY(84deg);
  }

  .storefront.is-opening .door__leaf--right {
    transform: rotateY(-84deg);
  }

  .storefront.is-opening .storefront__hint {
    opacity: 0;
  }

  /* Skip stays available, on a dark chip so it reads over the bright room */
  .storefront.is-opening .storefront__skip {
    background: rgb(27 23 20 / 0.85);
  }

  /* 1. through the door */
  .storefront.is-opening .storefront__scene {
    animation: storefront-enter calc(900ms * var(--pace)) var(--ease-in-out) calc(150ms * var(--pace)) both;
  }

  .storefront.is-opening .interior {
    pointer-events: auto;
    animation: interior-in calc(350ms * var(--pace)) linear calc(650ms * var(--pace)) both;
  }

  /* 2. down the aisle, with a slight bob for each step */
  .storefront.is-opening .interior__room {
    animation: room-walk calc(1300ms * var(--pace)) linear calc(600ms * var(--pace)) both;
  }

  /* 3. sit down: the room swings up out of view and the table comes up to meet us */
  .storefront.is-opening .interior__camera {
    animation: room-sit calc(650ms * var(--pace)) var(--ease-in-out) calc(1800ms * var(--pace)) both;
  }

  .storefront.is-opening .interior__table {
    animation: table-up calc(650ms * var(--pace)) var(--ease-out) calc(1800ms * var(--pace)) both;
  }

  /* 4. pick the menu up off the table */
  .storefront.is-opening .pickup__card {
    animation: menu-pickup calc(800ms * var(--pace)) var(--ease-in-out) calc(2400ms * var(--pace)) both;
  }

  .storefront.is-opening .pickup__band {
    animation: menu-band-out calc(800ms * var(--pace)) linear calc(2400ms * var(--pace)) both;
  }

  .storefront.is-opening .pickup__lines {
    animation: menu-lines-out calc(800ms * var(--pace)) linear calc(2400ms * var(--pace)) both;
  }

  /* 5. the menu in our hands becomes the menu page */
  .storefront.is-opening {
    animation: storefront-fade calc(350ms * var(--pace)) linear calc(3150ms * var(--pace)) both;
  }

  @keyframes storefront-enter {
    0% {
      transform: none;
      opacity: 1;
    }
    65% {
      opacity: 1;
    }
    100% {
      transform: scale(3.6);
      opacity: 0;
    }
  }

  @keyframes interior-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes room-walk {
    0% {
      transform: scale(var(--walk-from)) translateY(0);
    }
    20% {
      transform: scale(calc(var(--walk-from) + (var(--walk-to) - var(--walk-from)) * 0.18)) translateY(-0.7%);
    }
    40% {
      transform: scale(calc(var(--walk-from) + (var(--walk-to) - var(--walk-from)) * 0.38)) translateY(0.7%);
    }
    60% {
      transform: scale(calc(var(--walk-from) + (var(--walk-to) - var(--walk-from)) * 0.58)) translateY(-0.7%);
    }
    80% {
      transform: scale(calc(var(--walk-from) + (var(--walk-to) - var(--walk-from)) * 0.8)) translateY(0.7%);
    }
    100% {
      transform: scale(var(--walk-to)) translateY(0);
    }
  }

  @keyframes room-sit {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-55%);
    }
  }

  @keyframes table-up {
    from {
      transform: translateY(101%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes menu-pickup {
    0% {
      transform: translate(-50%, -50%) rotateX(63deg) rotateZ(-7deg) scale(0.66);
    }
    55% {
      transform: translate(-50%, calc(-50% - 24vh)) rotateX(0deg) rotateZ(0deg) scale(1);
    }
    100% {
      transform: translate(-50%, calc(-50% - 24vh)) rotateX(0deg) rotateZ(0deg) scale(9);
    }
  }

  @keyframes menu-band-out {
    0%,
    55% {
      opacity: 1;
    }
    85%,
    100% {
      opacity: 0;
    }
  }

  @keyframes menu-lines-out {
    0%,
    55% {
      opacity: 0.22;
    }
    85%,
    100% {
      opacity: 0;
    }
  }

  @keyframes storefront-fade {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @media (max-width: 30rem) {
    .glass {
      grid-template-columns: 0.7fr minmax(8rem, 1fr) 0.7fr;
    }

    .window {
      padding: var(--space-2);
    }
  }
</style>
