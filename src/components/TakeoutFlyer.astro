---
/** Social links as a takeout flyer. Links come from src/data/socials.json. */
import { getOrdered } from '../lib/content';

const socials = await getOrdered('socials');
---

<div class="flyer" data-filter-group>
  <div class="flyer__head">
    <p class="flyer__zh" lang="zh-Hant" aria-hidden="true">外賣</p>
    <div>
      <h2 class="flyer__title" id="takeout-title">Takeout</h2>
      <p class="flyer__sub">Take my details to go.</p>
    </div>
  </div>

  <ul class="flyer__list">
    {
      socials.map(({ data }) => (
        <li
          class="flyer__item"
          data-placeholder-item={data.placeholder ? '' : undefined}
          data-real-item={data.placeholder ? undefined : ''}
        >
          <span class="flyer__label">{data.label}</span>
          {data.placeholder ? (
            <span class="placeholder-badge">PLACEHOLDER</span>
          ) : (
            <a class="link" href={data.url} rel={data.platform === 'email' ? undefined : 'me noopener'}>
              {data.handle}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .flyer {
    max-width: 44rem;
    margin-inline: auto;
    border: var(--border);
    background: var(--color-yellow);
    box-shadow: var(--shadow-sheet);
    /* cut-out coupon corners */
    border-radius: var(--radius-sm);
    outline: 2px dashed var(--color-ink);
    outline-offset: -10px;
  }

  .flyer__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-6) var(--space-4);
  }

  .flyer__zh {
    flex: none;
    display: grid;
    place-items: center;
    padding: var(--space-2) var(--space-3);
    background: var(--color-red);
    color: var(--color-paper);
    font-family: var(--font-zh-display);
    font-weight: 900;
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .flyer__title {
    font-size: var(--text-2xl);
    text-transform: uppercase;
    color: var(--color-red);
  }

  .flyer__sub {
    font-weight: 700;
  }

  .flyer__list {
    padding: 0 var(--space-6) var(--space-6);
  }

  .flyer__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    min-height: var(--tap);
    padding-block: var(--space-2);
    border-top: 2px solid var(--color-ink);
  }

  .flyer__label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .flyer__item a {
    overflow-wrap: anywhere;
  }
</style>
