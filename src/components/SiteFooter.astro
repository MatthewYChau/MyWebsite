---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p>
      <span lang="zh-Hant">多謝惠顧</span> · Thanks for stopping by.
    </p>
    <p class="footer__small">© {year} Matthew Chau. Built with Astro.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-8);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
    /* leaves room for the order slip drawer on small screens */
    padding-bottom: calc(var(--space-5) + var(--slip-clearance, 0px));
  }

  .footer__small {
    font-size: var(--text-sm);
    opacity: 0.8;
  }
</style>
