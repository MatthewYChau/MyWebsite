---
/** Shopfront sign at the top of the menu page. */
---

<section class="shop tiles" aria-labelledby="shop-name">
  <div class="wrap shop__inner">
    <div class="sign">
      <div class="sign__board">
        <p class="sign__zh" lang="zh-Hant" aria-hidden="true">
          <span>茶</span><span>餐</span><span>廳</span>
        </p>
        <h1 class="sign__name" id="shop-name">Matthew Chau</h1>
      </div>
      <p class="sign__tagline">Mechanical Engineering · Project Management · Drones</p>
    </div>

    <div class="shop__below">
      <p class="hours">
        <span class="hours__label"><span lang="zh-Hant">營業時間</span> Opening hours</span>
        <span class="hours__value">Graduating April 2027</span>
      </p>
      <a class="btn" href="/menu/">View full menu</a>
    </div>
  </div>
</section>

<style>
  .shop {
    border-bottom: var(--border);
  }

  .shop__inner {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .sign {
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sheet);
  }

  .sign__board {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding: var(--space-6) var(--space-5);
    background: var(--color-red);
    overflow: hidden;
  }

  /* one pass of light across the sign when the page opens */
  .sign__board::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--sheen);
    background-size: 250% 100%;
    background-position: 120% 0;
    pointer-events: none;
    animation: sign-sheen 1100ms var(--ease-out) 200ms both;
  }

  @keyframes sign-sheen {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -30% 0;
    }
  }

  .sign__zh {
    display: flex;
    gap: var(--space-2);
    flex: none;
  }

  .sign__zh span {
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 2rem + 3.6vw, 5rem);
    aspect-ratio: 1;
    border: var(--border);
    border-radius: 50%;
    background: var(--color-yellow);
    color: var(--color-red);
    font-family: var(--font-zh-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    line-height: 1;
  }

  .sign__name {
    color: var(--color-paper);
    font-size: var(--text-3xl);
    text-transform: uppercase;
    /* raised channel letters */
    text-shadow:
      1px 1px 0 var(--color-red-deep),
      2px 2px 0 var(--color-red-deep),
      3px 3px 0 var(--color-ink),
      4px 4px 0 var(--color-ink);
  }

  .sign__tagline {
    padding: var(--space-3) var(--space-5);
    border-top: var(--border);
    background: var(--color-mint-deep);
    color: var(--color-yellow);
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 0.7rem + 0.9vw, 1.375rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .shop__below {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .hours {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: stretch;
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    box-shadow: var(--shadow-paper);
    font-weight: 700;
    overflow: hidden;
  }

  .hours__label {
    padding: var(--space-2) var(--space-3);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
  }

  .hours__value {
    padding: var(--space-2) var(--space-3);
  }
</style>
