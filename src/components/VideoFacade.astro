---
/**
 * YouTube video that loads nothing from YouTube until it is clicked.
 * Shows the thumbnail first, then swaps in the player.
 * Without JavaScript it is a plain link to the video on YouTube.
 */
interface Props {
  youtubeId: string;
  title: string;
  placeholder?: boolean;
}

const { youtubeId, title, placeholder = false } = Astro.props;
---

{
  placeholder ? (
    <div class="video video--placeholder">
      <span>PLACEHOLDER video</span>
    </div>
  ) : (
    <a
      class="video"
      href={`https://www.youtube.com/watch?v=${youtubeId}`}
      data-youtube={youtubeId}
      data-title={title}
      aria-label={`Play video: ${title}`}
    >
      <img src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
      <span class="video__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </a>
  )
}

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[data-youtube]');
    if (!link) return;
    event.preventDefault();

    const frame = document.createElement('iframe');
    frame.className = 'video video--frame';
    frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(link.dataset.youtube ?? '')}?autoplay=1&rel=0`;
    frame.title = link.dataset.title ?? 'YouTube video';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    frame.allowFullscreen = true;
    link.replaceWith(frame);
    frame.focus();
  });
</script>

<style is:global>
  .video {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-ink);
    overflow: hidden;
  }

  .video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  a.video:hover img {
    transform: scale(1.03);
  }

  .video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border: var(--border);
    border-radius: 50%;
    background: var(--color-red);
    transform: translate(-50%, -50%);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  a.video:hover .video__play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .video__play svg {
    width: 1.75rem;
    height: 1.75rem;
    margin-left: 3px;
    fill: var(--color-paper);
  }

  .video--placeholder {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(45deg, #6b6b6b 0 24px, #636363 24px 48px);
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .video--frame {
    padding: 0;
  }
</style>
